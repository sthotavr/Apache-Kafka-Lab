{
  "app": "npx ts-node --prefer-ts-exts bin/kafka.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules"
    ]
  },
  "context": {
    "kafkaVersion": "4.3.1",
    "instanceType": "c7i-flex.large",
    "heapSize": "1g",
    "volumeSizeGb": 30,
    "clientCidrs": []
  }
}